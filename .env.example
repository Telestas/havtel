# Base URL of the backend API
VITE_API_BASE_URL="http://localhost:8000"

# Stripe publishable key: no longer a build-time env var — it's fetched at
# runtime from GET /api/v1/payments/config, admin-configurable from the
# backoffice (Settings → Payments). Set it there, not here.

# Google Analytics 4 Measurement ID — embedded directly in index.html, no rebuild needed
# VITE_GA_MEASUREMENT_ID=G-3EMPM1PQ24
